APP_NAME=Giphy-Integration
APP_ENV=local
APP_KEY=base64:WvZ8a+/dqUxsq4crsqvsEe//NMb7q0JznjmQCvMsbvk=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuración corregida para interactuar dentro de la red de Docker Sail
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=giphy
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

# Credenciales de integración con la API de Giphy
GIPHY_API_KEY=SnfUK2t9gZTA2leY6JkZ0Ma9FxCwIoRA
