GIPHY_API_URL_BYID=https://api.giphy.com/v1/gifs/
GIPHY_DEFAULT_LIMIT=25
GIPHY_DEFAULT_OFFSET=0

BROADCAST_DRIVER=log
CACHE_DRIVER=file
